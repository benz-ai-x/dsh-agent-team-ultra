{
  "name": "@deepseek-ai/dsh-agent-team-ultra-profile",
  "description": "Local profile overlay for Agent Teams and Digital Employee Studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "bundle": "tsdown"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-agent-team-ultra": "0.1.0",
    "@deepseek-ai/dsh-client-ui-agent-team-ultra": "0.1.0",
    "@deepseek-ai/dsh-experimental-agent-team": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-experimental-client-ui-agent-team": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-experimental-tool-agent-team": "0.1.2-alpha.4"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-agent-team-ultra": { "optional": true },
    "@deepseek-ai/dsh-client-ui-agent-team-ultra": { "optional": true },
    "@deepseek-ai/dsh-experimental-agent-team": { "optional": true },
    "@deepseek-ai/dsh-experimental-client-ui-agent-team": { "optional": true },
    "@deepseek-ai/dsh-experimental-tool-agent-team": { "optional": true }
  },
  "devDependencies": {
    "@deepseek-ai/cordis-plugin-include": "link:../../../deepseek-harness/vendor/include",
    "@deepseek-ai/dsh-agent-team-ultra": "workspace:*",
    "@deepseek-ai/dsh-client-ui-agent-team-ultra": "workspace:*",
    "@deepseek-ai/dsh-experimental-agent-team": "link:../../../deepseek-harness/packages/experimental/agent-team",
    "@deepseek-ai/dsh-experimental-client-ui-agent-team": "link:../../../deepseek-harness/packages/experimental/client-ui-agent-team",
    "@deepseek-ai/dsh-experimental-tool-agent-team": "link:../../../deepseek-harness/packages/experimental/tool-agent-team"
  }
}
