{
  "name": "@benz-ai-x/dsh-agent-team-ultra-profile",
  "description": "Local profile overlay for Agent Teams and Digital Employee Studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "bundle": "node ../../scripts/check-harness-source.mjs && tsdown"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis-plugin-loader": "1.0.3",
    "@benz-ai-x/dsh-agent-team-ultra": "0.1.0",
    "@benz-ai-x/dsh-client-ui-agent-team-ultra": "0.1.0",
    "@deepseek-ai/dsh-experimental-agent-team": "0.1.2-rc.1",
    "@deepseek-ai/dsh-experimental-agent-team-claude-code": "0.1.2-rc.1",
    "@deepseek-ai/dsh-experimental-client-ui-agent-team": "0.1.2-rc.1",
    "@deepseek-ai/dsh-experimental-tool-agent-team": "0.1.2-rc.1",
    "@benz-ai-x/dsh-agent-team-codex": "0.1.0"
  },
  "peerDependenciesMeta": {
    "@benz-ai-x/dsh-agent-team-ultra": {
      "optional": true
    },
    "@benz-ai-x/dsh-client-ui-agent-team-ultra": {
      "optional": true
    },
    "@deepseek-ai/dsh-experimental-agent-team": {
      "optional": true
    },
    "@deepseek-ai/dsh-experimental-agent-team-claude-code": {
      "optional": true
    },
    "@deepseek-ai/dsh-experimental-client-ui-agent-team": {
      "optional": true
    },
    "@deepseek-ai/dsh-experimental-tool-agent-team": {
      "optional": true
    },
    "@benz-ai-x/dsh-agent-team-codex": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis-plugin-loader": "link:../../.dsh/harness/vendor/loader",
    "@deepseek-ai/cordis-plugin-include": "link:../../.dsh/harness/vendor/include",
    "@benz-ai-x/dsh-agent-team-ultra": "workspace:*",
    "@benz-ai-x/dsh-client-ui-agent-team-ultra": "workspace:*",
    "@deepseek-ai/dsh-experimental-agent-team": "link:../../.dsh/harness/packages/experimental/agent-team",
    "@deepseek-ai/dsh-experimental-agent-team-claude-code": "link:../../.dsh/harness/packages/experimental/agent-team-claude-code",
    "@deepseek-ai/dsh-experimental-client-ui-agent-team": "link:../../.dsh/harness/packages/experimental/client-ui-agent-team",
    "@deepseek-ai/dsh-experimental-tool-agent-team": "link:../../.dsh/harness/packages/experimental/tool-agent-team",
    "@benz-ai-x/dsh-agent-team-codex": "workspace:*"
  }
}
