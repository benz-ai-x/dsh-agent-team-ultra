{
  "name": "dsh-agent-team-ultra-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "context:check": "node scripts/verify-dsh-context.mjs",
    "context:check:strict": "node scripts/verify-dsh-context.mjs --require-source",
    "build:host": "tsc -b tsconfig.host.json && pnpm --dir packages/domain bundle && pnpm --dir packages/profile bundle",
    "build:client": "tsc -b tsconfig.client.json && pnpm --dir packages/ui bundle",
    "build": "pnpm run build:host && pnpm run build:client",
    "test": "vitest run",
    "test:watch": "vitest",
    "pack:local": "pnpm run context:check:strict && pnpm run build && node scripts/pack-local-overlay.mjs",
    "verify:pack": "node scripts/verify-pack.mjs",
    "verify": "pnpm run context:check:strict && pnpm run build && pnpm run test && pnpm run verify:pack"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-typert-generator": "link:../deepseek-harness/packages/typert/generator",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.0.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "^18.3.1",
    "js-yaml": "^4.2.0",
    "jsdom": "^26.1.0",
    "lightningcss": "^1.30.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsdown": "^0.22.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
